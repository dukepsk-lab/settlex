# ---------------------------------------------------------------------------
# settlex configuration. Copy to `.env` and fill in. NEVER commit your .env.
# ---------------------------------------------------------------------------

# --- Settrade Open API (market data) ---------------------------------------
# Request these from your Thai broker (e.g. Pi Securities) Settrade Open API
# console. For development you can use the sandbox broker id "SANDBOX".
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_BROKER_ID=SANDBOX
SETTRADE_APP_CODE=ALGO
# Optional, only needed if you later add account/portfolio features:
SETTRADE_ACCOUNT_NO=

# --- Telegram (signal delivery) --------------------------------------------
# Create a bot with @BotFather to get the token. Get your chat id by messaging
# the bot then calling https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Strategy parameters (override defaults) -------------------------------
SETTLEX_HORIZON=5            # forward-return prediction horizon in trading days (3-5)
SETTLEX_LOOKBACK=60          # sequence length fed to the CNN-BiLSTM
SETTLEX_TOP_N=5             # number of stocks in the portfolio
SETTLEX_MAX_WEIGHT=0.30     # max weight per stock in Markowitz optimisation
SETTLEX_CAPITAL=1000000    # capital base in THB
SETTLEX_RISK_FREE=0.02     # annual risk-free rate for Sharpe / max-Sharpe
SETTLEX_HISTORY_START=2015-01-01

# Optional: path to a newline-delimited file of SET50 symbols to override the
# built-in universe (e.g. for point-in-time backtesting).
# SETTLEX_UNIVERSE_FILE=

# Optional: override data/model cache locations.
# SETTLEX_DATA_DIR=
# SETTLEX_MODEL_DIR=
