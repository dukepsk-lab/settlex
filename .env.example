# ---------------------------------------------------------------------------
# settlex configuration. Copy to `.env` and fill in. NEVER commit your .env.
# ---------------------------------------------------------------------------

# --- Market data source ----------------------------------------------------
# "yahoo"    = Yahoo Finance EOD daily data, FREE, no credentials (default).
#              Ideal for after-close planning of the next trading day.
# "settrade" = Settrade Open API (requires the credentials below).
SETTLEX_DATA_SOURCE=yahoo

# --- Settrade Open API -----------------------------------------------------
# Only needed if SETTLEX_DATA_SOURCE=settrade, OR to auto-fetch your real
# account equity as the capital base in `signal`.
# Use SETTRADE_APP_CODE=ALGO_EQ for equities (ALGO is TFEX on some brokers).
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_BROKER_ID=SANDBOX
SETTRADE_APP_CODE=ALGO_EQ
# Set your equity account number to auto-fetch portfolio equity as capital:
SETTRADE_ACCOUNT_NO=

# --- Telegram (signal delivery) --------------------------------------------
# Create a bot with @BotFather to get the token. Get your chat id by messaging
# the bot then calling https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM providers for the `briefing` command (all optional) ---------------
# Each is independent: set only the ones you have. Missing keys just omit that
# section. Install SDKs with:  pip install -e ".[llm]"
# Claude (Anthropic) — synthesises the actionable order checklist.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Gemini (Google) — summarises news via Google Search grounding.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# DeepSeek — verifies yesterday's prediction accuracy (OpenAI-compatible API).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set to 0 to disable all LLM sections (briefing still shows the signal table).
SETTLEX_LLM_ENABLED=1

# --- Strategy parameters (override defaults) -------------------------------
SETTLEX_HORIZON=5            # forward-return prediction horizon in trading days (3-5)
SETTLEX_LOOKBACK=60          # sequence length fed to the CNN-BiLSTM
SETTLEX_TOP_N=5             # number of stocks in the portfolio
SETTLEX_MAX_WEIGHT=0.30     # max weight per stock in Markowitz optimisation
SETTLEX_CAPITAL=1000000    # capital base in THB
SETTLEX_RISK_FREE=0.02     # annual risk-free rate for Sharpe / max-Sharpe
SETTLEX_HISTORY_START=2015-01-01

# Optional: path to a newline-delimited file of SET50 symbols to override the
# built-in universe (e.g. for point-in-time backtesting).
# SETTLEX_UNIVERSE_FILE=

# Optional: override data/model cache locations.
# SETTLEX_DATA_DIR=
# SETTLEX_MODEL_DIR=
